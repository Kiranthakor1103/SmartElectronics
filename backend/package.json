{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "Enterprise-level backend for Flipkart-style e-commerce platform",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/server.js",
    "dev": "npx ts-node-dev --respawn --transpile-only src/server.ts",
