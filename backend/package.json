    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.24",
    "@types/nodemailer": "^6.4.14",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
