    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.2.0",
    "google-auth-library": "^9.7.0",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.2.1",
    "multer": "^2.3.0",
    "nodemailer": "^6.9.11",
    "pdfkit": "^0.20.2",
    "stripe": "^14.25.0",
    "zod": "^3.22.4"
